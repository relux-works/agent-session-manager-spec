@startuml session_directory_components
skinparam BackgroundColor #FFFFFF
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 45
skinparam component {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
    FontColor #000000
}
skinparam database {
    BackgroundColor #E8F5E9
    BorderColor #2E7D32
    FontColor #000000
}
skinparam node {
    BackgroundColor #FAFAFA
    BorderColor #616161
    FontColor #000000
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
    FontColor #000000
}
top to bottom direction

title AX Session Directory — Component and Authority Boundaries

actor Operator
actor "Automation / Agent" as Automation

package "Client Surfaces" as Clients {
    component "Session Browser TUI" as TUI
    component "Human CLI" as CLI
    component "Typed Agent Query" as Query
}

package "Directory Control Plane" as Directory {
    component "Directory Controller" as Controller
    component "Catalog + Freshness" as Catalog
    component "Conversation Lineage" as Lineage
    component "Enrichment Scheduler\n+ Policy" as Enrichment
    component "Continuation Planner" as Planner
    database "Derived SQLite Index" as Index
    database "Immutable Directory Records" as Records
}

package "Delegated AX Authority" as AX {
    component "State / Lease / Checkpoint" as AXState
    component "Mesh / Transfer" as AXMesh
    component "Workspace / Terminal" as AXRuntime
    component "Canonical Capture +\nTarget Projection" as Cloning
}

node "Source-Local Host" as Host {
    component "Directory Node" as NodeService
    component "Environment Adapter" as Adapter
    component "Sandboxed Enrichment Worker" as Worker
    database "Native Session Store" as NativeStores
}

Operator --> TUI
Operator --> CLI
Automation --> Query
TUI --> Controller
CLI --> Controller
Query --> Controller

Controller --> Catalog : browse
Controller --> Enrichment : schedule
Controller --> Planner : plan
Catalog --> Lineage : derive
Catalog --> Index : rebuild
Catalog --> Records : read / publish

Enrichment --> NodeService
NodeService --> Adapter
NodeService --> Worker : redacted input
Adapter --> NativeStores : source-local read
Worker --> NodeService : typed candidate
NodeService --> Records

NodeService --> AXMesh
Planner --> AXState
Planner --> AXMesh
Planner --> AXRuntime
Planner --> Cloning

note bottom of Records
  Index and display text are derived.
  Native transcripts stay source-local.
end note

@enduml
