@startuml
title <size:24>System Context View: Agent Session Manager (ax)</size>\n<size:24>System Context diagram for Agent Session Manager.</size>

set separator none
top to bottom direction
skinparam ranksep 60
skinparam nodesep 30
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #08427b;
    LineColor: #052e56;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0= {
    BackgroundColor: #1168bd;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
  }
</style>

person "==Operator\n<size:16>[Person]</size>\n\nSoftware developer running AI agents." <<Element-RWxlbWVudCxQZXJzb24=>> as Operator
rectangle "==Mesh Network\n<size:16>[Software System]</size>\n\nTailscale / OpenSSH trusted mesh transport." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as MeshNetwork
rectangle "==Native Provider Stores\n<size:16>[Software System]</size>\n\ne.g., ~/.claude/projects, ~/.codex/sessions." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as NativeProviderStores
rectangle "==Agent Session Manager (ax)\n<size:16>[Software System]</size>\n\nManages durable terminal sessions and AI agent task-boards across a mesh." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as AgentSessionManagerax
rectangle "==Task-Board / Session Manager\n<size:16>[Software System]</size>\n\nDistinct persistence and ownership boundary for AI agents." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as TaskBoardSessionManager

Operator --> AgentSessionManagerax <<Relationship-UmVsYXRpb25zaGlw>> : "Runs commands (launch, attach, takeover, fork, sync)"
TaskBoardSessionManager --> AgentSessionManagerax <<Relationship-UmVsYXRpb25zaGlw>> : "Provides task-board abstraction inside terminal"
AgentSessionManagerax --> TaskBoardSessionManager <<Relationship-UmVsYXRpb25zaGlw>> : "Imports/exports opaque session bundles (Bridge Contract)"
AgentSessionManagerax --> NativeProviderStores <<Relationship-UmVsYXRpb25zaGlw>> : "Materializes native state as directed by ax"
AgentSessionManagerax --> MeshNetwork <<Relationship-UmVsYXRpb25zaGlw>> : "Executes RPC (ax rpc serve --stdio) via SSH"

@enduml