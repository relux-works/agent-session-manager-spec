@startuml
title <size:24>Container View: Agent Session Manager (ax)</size>\n<size:24>Container diagram for AX state, directory, enrichment, continuation, and cloning boundaries.</size>

set separator none
top to bottom direction
skinparam ranksep 60
skinparam nodesep 30
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Container
  .Element-RWxlbWVudCxDb250YWluZXI= {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Database
  .Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U= {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #08427b;
    LineColor: #052e56;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
  }
  // Agent Session Manager (ax)
  .Boundary-QWdlbnQgU2Vzc2lvbiBNYW5hZ2VyIChheCk= {
    BackgroundColor: #ffffff;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

person "==Operator\n<size:16>[Person]</size>\n\nSoftware developer running AI agents." <<Element-RWxlbWVudCxQZXJzb24=>> as Operator
person "==Automation / Agent\n<size:16>[Person]</size>\n\nUses typed directory queries and guarded mutations." <<Element-RWxlbWVudCxQZXJzb24=>> as AutomationAgent

rectangle "Agent Session Manager (ax)\n<size:16>[Software System]</size>" <<Boundary-QWdlbnQgU2Vzc2lvbiBNYW5hZ2VyIChheCk=>> {
  rectangle "==Session Cloning Core\n<size:16>[Container: Go + Session Adapter 1.0]</size>\n\nCaptures, canonicalizes, projects, validates, and publishes cross-environment continuation lineage." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AgentSessionManagerax.SessionCloningCore
  rectangle "==ax Daemon\n<size:16>[Container: Go]</size>\n\nOptional user service for periodic sync, health, inventory, and enrichment scheduling." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AgentSessionManagerax.axDaemon
  rectangle "==Provider Plugins\n<size:16>[Container: Binary]</size>\n\nExecutable plugins (ax-provider-<id>) via JSON-over-stdio." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AgentSessionManagerax.ProviderPlugins
  rectangle "==Terminal Backend\n<size:16>[Container: System]</size>\n\ntmux (macOS/Linux/WSL2) or process/ConPTY (Windows)." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AgentSessionManagerax.TerminalBackend
  database "==Derived SQLite Index\n<size:16>[Container: SQLite]</size>\n\nRebuildable transactional index for AX state, directory catalog, and search." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as AgentSessionManagerax.DerivedSQLiteIndex
  database "==Immutable AX and Directory Records\n<size:16>[Container: File System]</size>\n\nContent-addressed blobs plus identity-addressed AX, cloning, and directory records." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as AgentSessionManagerax.ImmutableAXandDirectoryRecords
  rectangle "==ax CLI and Session Browser TUI\n<size:16>[Container: Go]</size>\n\nHuman command, browsing, selection, confirmation, launch, and attach surfaces." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AgentSessionManagerax.axCLIandSessionBrowserTUI
  rectangle "==Directory Control Plane\n<size:16>[Container: Go]</size>\n\nDiscovery, disclosure, catalog, lineage, enrichment, query, and continuation policy without session or workspace authority." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AgentSessionManagerax.DirectoryControlPlane
}

Operator --> AgentSessionManagerax.axCLIandSessionBrowserTUI <<Relationship-UmVsYXRpb25zaGlw>> : "Browses, selects, confirms, launches, and attaches"
AutomationAgent --> AgentSessionManagerax.axCLIandSessionBrowserTUI <<Relationship-UmVsYXRpb25zaGlw>> : "Submits typed projected reads and guarded mutations"
AgentSessionManagerax.axCLIandSessionBrowserTUI --> AgentSessionManagerax.DirectoryControlPlane <<Relationship-UmVsYXRpb25zaGlw>> : "Queries and confirms exact directory plans"
AgentSessionManagerax.DirectoryControlPlane --> AgentSessionManagerax.DerivedSQLiteIndex <<Relationship-UmVsYXRpb25zaGlw>> : "Rebuilds derived catalog and search index"
AgentSessionManagerax.DirectoryControlPlane --> AgentSessionManagerax.ImmutableAXandDirectoryRecords <<Relationship-UmVsYXRpb25zaGlw>> : "Reads immutable observations and batches"
AgentSessionManagerax.DirectoryControlPlane --> AgentSessionManagerax.SessionCloningCore <<Relationship-UmVsYXRpb25zaGlw>> : "Delegates cross-environment continuation"
AgentSessionManagerax.DirectoryControlPlane --> AgentSessionManagerax.TerminalBackend <<Relationship-UmVsYXRpb25zaGlw>> : "Delegates managed launch or attach"
AgentSessionManagerax.DirectoryControlPlane --> AgentSessionManagerax.ProviderPlugins <<Relationship-UmVsYXRpb25zaGlw>> : "Delegates existing AX ownership and provider effects"
AgentSessionManagerax.SessionCloningCore --> AgentSessionManagerax.ProviderPlugins <<Relationship-UmVsYXRpb25zaGlw>> : "Uses Provider 2 and companion Session Adapter 1 transactions"
AgentSessionManagerax.SessionCloningCore --> AgentSessionManagerax.ImmutableAXandDirectoryRecords <<Relationship-UmVsYXRpb25zaGlw>> : "Publishes clone evidence and lineage"
AgentSessionManagerax.axCLIandSessionBrowserTUI --> AgentSessionManagerax.DerivedSQLiteIndex <<Relationship-UmVsYXRpb25zaGlw>> : "Reads/writes index"
AgentSessionManagerax.axCLIandSessionBrowserTUI --> AgentSessionManagerax.ImmutableAXandDirectoryRecords <<Relationship-UmVsYXRpb25zaGlw>> : "Reads/writes records and blobs"
AgentSessionManagerax.axDaemon --> AgentSessionManagerax.DerivedSQLiteIndex <<Relationship-UmVsYXRpb25zaGlw>> : "Reads/writes index"
AgentSessionManagerax.axDaemon --> AgentSessionManagerax.ImmutableAXandDirectoryRecords <<Relationship-UmVsYXRpb25zaGlw>> : "Syncs records and blobs"
AgentSessionManagerax.axDaemon --> AgentSessionManagerax.DirectoryControlPlane <<Relationship-UmVsYXRpb25zaGlw>> : "Schedules source-local inventory and health"
AgentSessionManagerax.axCLIandSessionBrowserTUI --> AgentSessionManagerax.TerminalBackend <<Relationship-UmVsYXRpb25zaGlw>> : "Runs 'ax pane' wrapper in durable pane"
AgentSessionManagerax.axCLIandSessionBrowserTUI --> AgentSessionManagerax.ProviderPlugins <<Relationship-UmVsYXRpb25zaGlw>> : "Launches and orchestrates transactions via JSON-over-stdio"

@enduml